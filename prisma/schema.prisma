generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/stock-history.db"
}

model Account {
  id            String   @id
  broker        String
  accountNumber String
  nickname      String?
  memo          String?
  createdAt     String
  updatedAt     String
  trades        Trade[]
}

model Trade {
  id                   String       @id
  accountId            String
  symbol               String
  symbolCode           String?
  comment              String?
  exitComment          String?
  targetPrice          Float?
  stopLossPrice        Float?
  plannedHoldingPeriod String?
  tradeScore           Int?
  strategyId           String?
  createdAt            String
  updatedAt            String
  account              Account      @relation(fields: [accountId], references: [id])
  strategy             Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  buyEntries           BuyEntry[]
  sellEntries          SellEntry[]
  images               TradeImage[]
}

// 매매 전략 (예: 10일 스윙) — 거래를 묶어 회차별 승패·누적 복리·계획 대비 이탈을 본다
model Strategy {
  id            String  @id
  name          String
  description   String?
  targetPct     Float?  // 익절 목표 수익률 (%)
  stopLossPct   Float?  // 손절 기준 손실률 (%, 양수)
  plannedDays   Int?    // 계획 보유일
  seedMoney     Float?  // 시뮬레이션 시작 금액
  feePct        Float?  // 1회 매매당 수수료·세금 (%)
  createdAt     String
  updatedAt     String
  trades        Trade[]
}

model TradeImage {
  id        String @id
  tradeId   String
  filename  String
  createdAt String
  trade     Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model CoinTrade {
  id                   String           @id
  symbol               String
  comment              String?
  plannedHoldingPeriod String?
  tradeScore           Int?
  createdAt            String
  updatedAt            String
  buyEntries           CoinBuyEntry[]
  sellEntries          CoinSellEntry[]
}

model CoinBuyEntry {
  id        String    @id
  tradeId   String
  date      String
  price     Float
  quantity  Float
  createdAt String
  trade     CoinTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model CoinSellEntry {
  id        String    @id
  tradeId   String
  date      String
  price     Float
  quantity  Float
  createdAt String
  trade     CoinTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model StockMaster {
  id          String @id
  symbol      String @unique
  symbolCode  String
  tags        String?
  marketType  String?
  createdAt   String
  updatedAt   String
}

model Memo {
  id          String       @id
  content     String
  showOnMain  Boolean      @default(false)
  showOnCoin  Boolean      @default(false)
  rating      Int?
  category    String?
  alertDate   String?
  reviewedAt  String?
  createdAt   String
  updatedAt   String
  images      MemoImage[]
  symbols     MemoSymbol[]
}

model MemoSymbol {
  id        String @id
  memoId    String
  symbol    String
  memo      Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model MemoImage {
  id        String @id
  memoId    String
  filename  String
  createdAt String
  memo      Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model SimEntry {
  id        String @id
  tradeId   String
  price     Float
  quantity  Int
  createdAt String
}

model TradeScenario {
  tradeId      String  @id
  currentPrice String?
  budget       String?
  targetProfit String?
  rowsJson     String
  createdAt    String
  updatedAt    String
}

model BuyEntry {
  id        String @id
  tradeId   String
  date      String
  price     Float
  quantity  Int
  createdAt String
  trade     Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model SellEntry {
  id        String @id
  tradeId   String
  date      String
  price     Float
  quantity  Int
  createdAt String
  trade     Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}
